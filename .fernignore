# Specify files that shouldn't be modified by Fern
README.md

# Hand-written agent-workflows-as-code builder: a layer on top of the generated client that the
# generator does not emit. Mirrors the Python/TS SDKs and passes the shared conformance fixtures.
src/agent_workflows/
tests/agent_workflows_fixtures.rs
tests/agent_workflows_backward.rs
tests/fixtures/agent_workflows/

# Hand-written agent-tools-as-code builder (webhook, client and system tools): a layer on top of
# the generated client that the generator does not emit. Mirrors the TS/Python SDKs and passes the
# shared conformance fixtures. Declared in src/lib.rs (`pub mod agent_tools;`), which is frozen below.
src/agent_tools/
tests/agent_tools_fixtures.rs
tests/fixtures/agent_tools/

# Frozen to protect the hand-written wiring Fern does not emit:
#  - Cargo.toml: the serde_json `preserve_order` feature the builder needs for document-order loads,
#    and `float_roundtrip`, which the agent_tools builder needs to reload its floats exactly.
#  - src/lib.rs: the `pub mod agent_workflows;` declaration (a crate-root module must be declared
#    here). See the PR description for the proper fix (a Fern custom-module extension point).

# Hand-written Speech Engine inbound-server surface. The generator only emits the upstream channel
# client (src/api/websocket/speech_engine.rs); the server side is maintained by hand to match the
# Python/TS/PHP SDKs.
src/speech_engine/

# Frozen to protect the hand-written wiring Fern does not emit:
#  - Cargo.toml: the hmac/sha2/base64 (and optional axum) dependencies the server surface needs.
#  - src/lib.rs: the `pub mod speech_engine;` declaration (a crate-root module must be declared
#    here). Keeping it in .fernignore means a regeneration cannot silently drop these; the
#    trade-off is that genuinely new generated top-level modules would need to be merged in by
#    hand. See the PR description for the proper fix (a Fern custom-module extension point).
Cargo.toml
src/lib.rs

# Hand-written webhook signature verifier. Fern's built-in verifier can't parse the compound
# `ElevenLabs-Signature: t=...,v0=...` header, so this matches the Python/TS/PHP/Ruby SDKs by hand.
# Declared in src/lib.rs (`pub mod webhooks;`), which is already frozen above.
src/webhooks/
tests/webhooks_verifier.rs

# Hand-written flows `create_and_wait` helpers (`client.flows().image().create_and_wait(...)`).
# The generated flows `create`/`get` methods don't expose response headers, so this module builds
# the same requests, on a transport built from the root client config, to read `Retry-After`.
# Matches the Python/TS SDKs.
# Declared in src/lib.rs (`pub mod flows;`), which is already frozen above.
src/flows/
tests/flows_create_and_wait.rs

# Hand-written parsed music `compose_detailed`. `POST /v1/music/detailed` returns a `multipart/mixed`
# body (JSON metadata + audio) that the generated method decodes as JSON and fails on. Declared in
# src/lib.rs (`pub mod music_detailed;`), which is already frozen above.
src/music_detailed/
tests/music_detailed.rs
